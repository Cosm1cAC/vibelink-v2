+/** A Hub principal owns a real local runtime but is never a Cindy cloud user.
+ * Existing Cindy credentials stay untouched for rollback to the original app. */
+export async function commitHubOwner(ownerId: string | null): Promise<void> {
+  if (process.env.CINDY_VIBELINK_EMBEDDED !== '1') throw new Error('Hub identity requires VibeLink mode');
+  const previous = getActiveAppSession();
+  const nextMode = ownerId ? 'hub' : 'signed-out';
+  if (previous.mode === nextMode && previous.dataOwnerId === ownerId && isGhostSkillProjectionBoundaryStableForOwner(ownerId)) return;
+  let release: (() => void) | undefined;
+  let shellPending = false;
+  try {
+    await withGhostSkillProjectionOwnerCommit({
+      previousOwnerId: previous.dataOwnerId, nextOwnerId: ownerId,
+      prepareTransition: async ({ ownerChanged }) => {
+        notifyRendererAuthBoundaryPending();
+        enterOwnerChangeShellPending(); shellPending = true;
+        release = beginAppSessionBoundary();
+        const teardown = ownerChanged ? authSessionTeardown : projectionRepairTeardown;
+        if (!teardown) throw new Error('Hub owner transition requires runtime teardown');
+        await teardown('vibelink-hub-owner-change');
+      },
+      commit: () => {
+        clearAuth({ notify: false, nextMode: 'signed-out', preservePersistedRefreshToken: true, deferSessionCommit: true });
+        commitActiveAppSession(nextMode, ownerId, true);
+      },
+    });
+  } catch (error) {
+    // A failed runtime handover must not leave the outgoing owner enterable.
+    // The durable Ghost quarantine still requires a successful sweep on retry.
+    commitVolatileAppSession('signed-out');
+    throw error;
+  } finally {
+    release?.();
+    if (shellPending) leaveOwnerChangeShellPending();
+    notifyRenderer(); notifyAuthListeners();
+  }
+  requestStableOwnerPostCommit('hub-owner-commit');
+}
+
 async function recoverAccountFreeOwnerAtStartup(
   mode: Extract<AppSessionMode, 'signed-out' | 'local'>,
   reason: string,
