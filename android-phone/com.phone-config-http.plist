<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.phone-config-http</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>while true; do /usr/bin/python3 -m http.server 18991 --bind 100.105.59.31 --directory /Users/kobayashi/phone-setup; sleep 2; done</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/kobayashi/.config/phone-config-http/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/kobayashi/.config/phone-config-http/stderr.log</string>
</dict>
</plist>
